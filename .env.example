# Comma-separated account labels. Each gets its own WhatsApp session (QR scan).
ACCOUNTS=main

# Numbers allowed to talk to the agent, digits only with country code,
# comma-separated. Anyone else is silently ignored. REQUIRED.
OWNER_NUMBERS=628xxxxxxxxxx

# Absolute path to the agent's workspace. This is the cwd for every
# `claude -p` run: its CLAUDE.md becomes the agent's standing instructions,
# and its files are what the agent can read/write.
WORKSPACE_DIR=/absolute/path/to/workspace

# Where WhatsApp session credentials live. Default: ./sessions
#SESSION_DIR=

# Where per-chat agent session state lives. Default: ./state
#STATE_DIR=

# Start a fresh Claude session after this many minutes of silence. Default: 30
#SESSION_IDLE_MINUTES=30

# Max seconds to wait for one agent run before giving up. Default: 300
#AGENT_TIMEOUT_SECONDS=300

# Path to the claude binary if not on PATH.
#CLAUDE_BIN=claude

# Optional: notify yourself when the WA session drops (needs re-scan).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
