# Comma-separated account labels. Each gets its own WhatsApp session (QR scan).
ACCOUNTS=main

# Numbers allowed to talk to the agent, digits only with country code,
# comma-separated. Anyone else is silently ignored. REQUIRED.
OWNER_NUMBERS=628xxxxxxxxxx

# The agent's workspace: its CLAUDE.md becomes the standing instructions, and
# its files are what the agent reads and writes. A NAME lives under the
# managed root (~/.killa/workspaces/<name>) — create one with
# `npm run workspace new <name>`. An absolute path also works if you keep your
# workspace elsewhere (a git repo, a shared disk).
WORKSPACE=main

# Where managed workspaces live. Default: ~/.killa/workspaces
#WORKSPACES_DIR=

# Per-account overrides — one process, several numbers, different personas.
# The suffix is the account label from ACCOUNTS, upper-cased.
#WORKSPACE_KERJA=kantor
#OWNER_NUMBERS_KERJA=628xxxxxxxxxx

# Where WhatsApp session credentials live. Default: ./sessions
#SESSION_DIR=

# Where per-chat agent session state lives. Default: ./state
#STATE_DIR=

# Start a fresh Claude session after this many minutes of silence. Default: 30
#SESSION_IDLE_MINUTES=30

# Max seconds to wait for one agent run before giving up. Default: 300
#AGENT_TIMEOUT_SECONDS=300

# Path to the claude binary if not on PATH.
#CLAUDE_BIN=claude

# Optional: notify yourself when the WA session drops (needs re-scan).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Timezone for reminders — the USER's, not the server's. A VPS is usually UTC,
# so set this or "remind me at 7" fires at the wrong hour. Any IANA name.
# Default: whatever the server is set to.
#TIMEZONE=Asia/Jakarta

# Max reminders delivered per chat per day (safety valve on outbound). Default: 20
#REMINDERS_MAX_PER_DAY=20
